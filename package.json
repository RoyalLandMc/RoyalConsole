{
  "name": "royalconsole",
  "version": "0.2.1",
  "description": "SSH console and server monitor for Windows",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "postdist": "node -e \"const fs=require('fs'),p=require('path'),d=p.join(require('os').homedir(),'Desktop','RoyalConsole');fs.mkdirSync(d,{recursive:true});for(const f of fs.readdirSync('dist'))if(f.endsWith('.exe'))fs.copyFileSync(p.join('dist',f),p.join(d,f));console.log('copied to '+d)\""
  },
  "build": {
    "appId": "ir.royalland.console",
    "productName": "RoyalConsole",
    "files": [
      "src/**",
      "node_modules/**"
    ],
    "win": {
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "RoyalConsole-Setup-${version}.exe"
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "ssh2": "^1.16.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
