{
  "name": "royalconsole",
  "version": "0.1.0",
  "description": "SSH console and server monitor for Windows",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "ir.royalland.console",
    "productName": "RoyalConsole",
    "files": [
      "src/**",
      "node_modules/**"
    ],
    "win": {
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "RoyalConsole-Setup-${version}.exe"
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "ssh2": "^1.16.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
